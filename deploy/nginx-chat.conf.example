# Include inside the HTTPS server {} for your real domain.
# Configure certificates on that server; set XIAOZHI_CHAT_PUBLIC_ORIGIN to its origin.
# WebSocket proxy reference: https://nginx.org/en/docs/http/websocket.html
location /xiaozhi-ws/ {
    # Trailing slash strips /xiaozhi-ws/ and preserves the opaque connection ticket.
    proxy_pass http://127.0.0.1:8766/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header Origin $http_origin;
    proxy_read_timeout 14400s;
    proxy_send_timeout 14400s;
    proxy_buffering off;
    access_log off;
}

location / {
    proxy_pass http://127.0.0.1:8501;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 14400s;
    proxy_send_timeout 14400s;
    proxy_buffering off;
}
